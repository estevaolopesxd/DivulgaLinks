# ═══════════════════════════════════════════════════════════════════════
#  DivulgaLinks — Variáveis de Ambiente
#  Copie este arquivo para .env e ajuste os valores
# ═══════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────
# SUPABASE — Banco de Dados
# ─────────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=divulgalinks123
POSTGRES_DB=divulgalinks
POSTGRES_PORT=5432

# ─────────────────────────────────────────────────────────────────────
# SUPABASE — JWT
#
# IMPORTANTE: Troque TODOS os valores abaixo antes de ir para produção!
#
# Para gerar um novo JWT_SECRET:
#   openssl rand -base64 40
#
# Para gerar ANON_KEY e SERVICE_ROLE_KEY a partir do JWT_SECRET:
#   Acesse: https://supabase.com/docs/guides/self-hosting/docker#generate-api-keys
#   Ou use: https://jwt.io  (payload: {"role":"anon","iss":"supabase","iat":...,"exp":...})
#
# ⚠️  As chaves abaixo são EXEMPLO — válidas até 2027 apenas para dev local!
# ─────────────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
JWT_EXPIRY=3600

ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlLWRlbW8iLCJpYXQiOjE2NDE3NjkyMDAsImV4cCI6MTc5OTUzNTYwMH0.dc_X5iR_VP_qroESHHSJJIKCpYqYJByHViw4ih7d_v4
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoic3VwYWJhc2UtZGVtbyIsImlhdCI6MTY0MTc2OTIwMCwiZXhwIjoxNzk5NTM1NjAwfQ.DaYlNEoUrrEn2Ig7tqibS-PHK5vgusbcbo7X36XVt4Q

# Usado pelo Supabase Realtime — gere com: openssl rand -base64 48
SECRET_KEY_BASE=UpNVntn3cDxHJpq99YMc1T1AQgQpc8kfYTuRgBiYa15BLrx8etQoXz3gZv1/u2oq

# ─────────────────────────────────────────────────────────────────────
# SUPABASE — URLs
# ─────────────────────────────────────────────────────────────────────
# URL pública da API Supabase (Kong gateway)
API_EXTERNAL_URL=http://localhost:8000

# URL do site (usada pelo GoTrue para redirects de e-mail)
SITE_URL=http://localhost:3000

# URLs adicionais permitidas para redirect de auth (separadas por vírgula)
ADDITIONAL_REDIRECT_URLS=

# ─────────────────────────────────────────────────────────────────────
# SUPABASE — Studio
# ─────────────────────────────────────────────────────────────────────
STUDIO_DEFAULT_ORGANIZATION=DivulgaLinks
STUDIO_DEFAULT_PROJECT=divulgalinks

# ─────────────────────────────────────────────────────────────────────
# SUPABASE — Auth (GoTrue)
# ─────────────────────────────────────────────────────────────────────
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
# true = confirma e-mail automaticamente (ideal para dev, desative em prod)
ENABLE_EMAIL_AUTOCONFIRM=true

# ─────────────────────────────────────────────────────────────────────
# SUPABASE — SMTP (e-mails de auth)
# Em desenvolvimento usa o Inbucket (http://localhost:54324)
# Em produção, configure seu servidor SMTP real
# ─────────────────────────────────────────────────────────────────────
SMTP_ADMIN_EMAIL=admin@divulgalinks.com.br
SMTP_HOST=inbucket
SMTP_PORT=2500
SMTP_USER=fake_mail_user
SMTP_PASS=fake_mail_password
SMTP_SENDER_NAME=DivulgaLinks

# ─────────────────────────────────────────────────────────────────────
# SUPABASE — Portas (mude se houver conflitos)
# ─────────────────────────────────────────────────────────────────────
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443
SUPABASE_STUDIO_PORT=54323
INBUCKET_PORT=54324

# ─────────────────────────────────────────────────────────────────────
# APLICAÇÃO — Backend
# ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
# JWT_SECRET é compartilhado com o Supabase (mesma variável acima)

# Prisma (DIRECT_URL = mesma URL quando não usa connection pooler)
# Em Docker: @db:5432  |  Local: @localhost:5432
DIRECT_URL=postgresql://postgres:divulgalinks123@db:5432/divulgalinks

# Redis
REDIS_URL=redis://redis:6379

# URLs da aplicação
FRONTEND_URL=http://localhost

# URL pública da aplicação — necessária para uploads do Instagram
# O Instagram Graph API precisa baixar a imagem deste endereço.
# Coloque o domínio público sem barra no final.
PUBLIC_URL=https://divulgalinks.morphbh.com.br

# Cloudflare Tunnel — gere o token em: https://one.dash.cloudflare.com → Zero Trust → Tunnels
CLOUDFLARE_TUNNEL_TOKEN=

# VITE_API_URL e VITE_SOCKET_URL devem ficar VAZIOS em produção
# O nginx do frontend já faz proxy /api/ → backend internamente
VITE_API_URL=
VITE_SOCKET_URL=

# ─────────────────────────────────────────────────────────────────────
# PLATAFORMAS DE AFILIADOS (opcional)
# ─────────────────────────────────────────────────────────────────────

# Amazon (PA-API) — https://affiliate-program.amazon.com
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=

# Mercado Livre — https://developers.mercadolibre.com.br
MERCADOLIVRE_APP_ID=
MERCADOLIVRE_SECRET_KEY=
MERCADOLIVRE_ACCESS_TOKEN=

# Shopee Affiliate — https://affiliate.shopee.com.br
SHOPEE_APP_ID=
SHOPEE_SECRET=

# AliExpress — https://portals.aliexpress.com
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=

# AWIN — https://www.awin.com
AWIN_API_TOKEN=
AWIN_PUBLISHER_ID=

# Magalu — https://parceiro.magazineluiza.com.br
MAGALU_PUBLISHER_ID=

